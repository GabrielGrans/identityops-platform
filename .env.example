POSTGRES_DB=identityops
POSTGRES_USER=identityops
POSTGRES_PASSWORD=change_me_before_use
POSTGRES_PORT=5432

SECRET_KEY=replace_with_a_generated_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Opt in to the backend-only, read-only Microsoft Entra integration.
ENTRA_ENABLED=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
ENTRA_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
ENTRA_HTTP_TIMEOUT_SECONDS=10

# The Entra worker is an independent process; run it separately for scheduled monitoring.
ENTRA_SYNC_INTERVAL_MINUTES=10
